{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "type": "object",
  "required": [
    "decision_id",
    "customer_id",
    "decision",
    "confidence",
    "reason_codes",
    "policy_version",
    "timestamp"
  ],
  "properties": {
    "decision_id": {"type": "string"},
    "customer_id": {"type": "string"},
    "decision": {
      "type": "string",
      "enum": ["RECOMMEND", "INTERVENE", "VERIFY", "NO_ACTION"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "action": {
      "type": ["object", "null"]
    },
    "signals": {
      "type": ["object", "null"]
    },
    "policy_version": {"type": "string"},
    "timestamp": {"type": "string"}
  }
}
